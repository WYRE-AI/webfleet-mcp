{
  "name": "@wyre-ai/webfleet-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for the Bridgestone Webfleet WEBFLEET.connect API: vehicles, drivers, trips, tracks, events, KPIs, addresses, and orders.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "webfleet-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WYRE-AI/webfleet-mcp"
  },
  "homepage": "https://github.com/WYRE-AI/webfleet-mcp",
  "scripts": {
    "build": "tsup",
    "prebuild": "npm run clean",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node scripts/lint-destructive-warnings.mjs src",
    "lint:destructive": "node scripts/lint-destructive-warnings.mjs src",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-stdio.mjs",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "webfleet",
    "webfleet-connect",
    "bridgestone",
    "telematics",
    "fleet",
    "mcp",
    "msp",
    "model-context-protocol"
  ],
  "author": "WYRE Technology",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
