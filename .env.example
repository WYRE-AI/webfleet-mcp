# Webfleet (WEBFLEET.connect) MCP environment.
# The upstream host is fixed at https://csv.webfleet.com/extern; there is no
# base URL or host setting.

# WEBFLEET.connect connection (stdio, and HTTP only when AUTH_MODE=env).
# Use a dedicated integration user with the WEBFLEET.connect access right and
# read-only report rights; never an admin. Gateway mode ignores these; the
# connection arrives per request on X-Webfleet-Account, X-Webfleet-Username,
# X-Webfleet-Password, and X-Webfleet-Api-Key. Never commit real values.
WEBFLEET_ACCOUNT=
WEBFLEET_USERNAME=
WEBFLEET_PASSWORD=
# Exactly 36 characters (WEBFLEET.connect API key).
WEBFLEET_API_KEY=

# Tool tiers to expose. Every tool is read-only, so the only tier is read.
# In HTTP mode Conduit may send X-Conduit-Tool-Tiers to narrow (never widen)
# this set per request; an empty header exposes no tools.
# WEBFLEET_TOOL_TIERS=read

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Bind address for MCP_TRANSPORT=http. Defaults to 127.0.0.1. The container
# image sets 0.0.0.0 and requires CONDUIT_S2S_SECRET. Any gateway-to-server
# hop that leaves the host must run over TLS: credentials travel in headers.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Optional Host-header allowlist for /mcp (comma-separated, case-insensitive,
# with or without port). Requests with any other Host get 403. Unset = no check.
# MCP_ALLOWED_HOSTS=webfleet-mcp.internal,localhost

# Required to start the HTTP transport. Leave empty here; never commit a value.
# Generate with: openssl rand -hex 32
# Startup refuses secrets shorter than 32 characters, known placeholders, and
# repeated patterns. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Exactly 1 starts HTTP without CONDUIT_S2S_SECRET,
# skips the X-Gateway-S2S check, and binds 127.0.0.1 regardless of
# MCP_HTTP_HOST. A placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (WEBFLEET_* above) or gateway (the four
# X-Webfleet-* headers on every request; no env fallback). The container image
# sets gateway. stdio reads WEBFLEET_* unless AUTH_MODE=gateway.
# AUTH_MODE=env

# Upstream timeout. WEBFLEET.connect serialises requests per account/user, so
# aborting early makes the next call fail with 8015. Default 60000, max 300000.
# WEBFLEET_REQUEST_TIMEOUT_MS=60000
# WEBFLEET_MAX_RESPONSE_CHARS=60000
# WEBFLEET_MAX_UPSTREAM_BYTES=4194304
# LOG_LEVEL=info
