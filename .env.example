# WEBFLEET.connect credentials (single-tenant / stdio).
# Steadfast rotates these. Do not commit real values.
# Username and password are sent as HTTP Basic Auth, never as query parameters.
# account and apikey (exactly 36 characters) are query parameters.
WEBFLEET_ACCOUNT=your_webfleet_account
WEBFLEET_API_KEY=0123456789abcdef0123456789abcdef0123
WEBFLEET_USERNAME=your_webfleet_username
WEBFLEET_PASSWORD=your_webfleet_password

# Optional. Current reference host is csv.webfleet.com (WEBFLEET.connect 1.74).
# csv.telematics.tomtom.com is the legacy pre-rebrand hostname.
# WEBFLEET_HOST=csv.webfleet.com
# WEBFLEET_LANG=en

# Server
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
NODE_ENV=development

# Optional gateway service-to-service secret. Empty disables enforcement.
# CONDUIT_S2S_SECRET=
